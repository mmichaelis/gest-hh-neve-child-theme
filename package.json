{
  "name": "gest-hh-neve-child",
  "version": "1.4.3-rc.0",
  "description": "",
  "main": "index.js",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": "26",
    "pnpm": "12"
  },
  "private": true,
  "scripts": {
    "about": "node ./scripts/about.mts",
    "preadd": "node ./scripts/check-pnpm.mts",
    "build": "node ./scripts/build.mts ./src ./build",
    "clean": "rimraf ./build",
    "preinstall": "node ./scripts/check-pnpm.mts",
    "lint": "pnpm run eslint && pnpm run typecheck && pnpm run formatcheck && pnpm run markdownlint",
    "postlint": "pnpm run stylelint",
    "eslint": "eslint --max-warnings 0",
    "formatcheck": "prettier --check .markdownlint-cli2.jsonc package.json tsconfig.json \"scripts/**/*.mts\"",
    "lint:fix": "prettier --write .markdownlint-cli2.jsonc package.json tsconfig.json \"scripts/**/*.mts\" && eslint --fix --max-warnings 0 && stylelint --fix --max-warnings 0 \"src/**/*.css\" && markdownlint-cli2 --fix",
    "markdownlint": "markdownlint-cli2",
    "typecheck": "tsc --noEmit",
    "stylelint": "stylelint --max-warnings 0 \"src/**/*.css\"",
    "preremove": "node ./scripts/check-pnpm.mts",
    "update-actions": "node ./scripts/update-actions.mts",
    "verify": "bash ./bin/verify.sh",
    "preversion": "pnpm run lint",
    "version": "pnpm run build",
    "postversion": "exit 0",
    "wordpress-theme-meta": "node ./scripts/wordpress-theme-meta.mts"
  },
  "keywords": [],
  "author": "Mark Michaelis",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@npmcli/package-json": "^8.0.1",
    "@types/minimist": "^1.2.5",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-yml": "^3.10.0",
    "globals": "^17.14.0",
    "markdownlint-cli2": "^0.24.1",
    "minimist": "^1.2.8",
    "node-fetch": "^3.3.2",
    "prettier": "^3.10.1",
    "rimraf": "^6.1.4",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "typescript": "^7.0.2"
  }
}
